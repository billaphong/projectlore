{
  "mcpServers": {
    "projectlore": {
      "type": "stdio",
      "command": "${PROJECTLORE_PYTHON:-.venv/Scripts/python.exe}",
      "args": [
        "-I",
        "-m",
        "projectlore.mcp_server"
      ],
      "env": {
        "PROJECTLORE_MODEL": "examples/homebrew.forecast-trust.project.yaml"
      }
    }
  }
}
