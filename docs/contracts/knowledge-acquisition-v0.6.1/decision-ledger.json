    {
      "id": "G06",
      "class": "governed",
      "classification": "normative",
      "value": "Current-format corrupt/fork state repairs only from one verified prior branch; otherwise refuses or uses explicit remove/re-onboard preserving canonical queries",
      "exact_schema_or_bound": "recovery-contract; schemas repair_evidence/repair_preview/lifecycle_receipt; PLKA6007-6011",
