      "source_rationale": "determinism, confinement, RFC3339/Unicode plus architecture",
      "alternatives": [
        "platform normalization"
      ],
      "compatibility_consequence": "unsafe or non-production state refuses/quarantines",
      "falsifier_validation": "cross-platform bytes differ or negative vector passes"
    },
    {
