      "source_rationale": "AGENTS architecture; KA-01/03/13",
      "alternatives": [
        "workflow canonical"
      ],
      "compatibility_consequence": "preserves core query authority",
      "falsifier_validation": "any read/hook changes canonical digest"
    },
    {
      "id": "G02",
      "class": "governed",
      "classification": "normative",
      "value": "canonical then workflow continuous locks and old/new recovery",
      "exact_schema_or_bound": "fault state table/model checker",
      "source_rationale": "plans v1.7-v1.12",
      "alternatives": [
        "release/reacquire"
      ],
      "compatibility_consequence": "all writers use shared admission",
      "falsifier_validation": "neither/mixed/deadlock trace"
    },
    {
      "id": "G03",
      "class": "governed",
      "classification": "normative",
      "value": "Stop metadata-only advisory; no prompt/transcript persistence",
