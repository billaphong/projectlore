      "source_rationale": "standards define mechanisms, not product selection",
      "alternatives": [
        "canonical CBOR",
        "raw bytes"
      ],
      "compatibility_consequence": "future accepted version changes require a separately authorized registry",
      "falsifier_validation": "golden mismatch/owner choice",
      "recommendation": "accept portable inspectable convention"
    },
    {
      "id": "P02",
      "class": "irreducible_product_policy",
      "classification": "provisional",
      "value": "complete persisted/public object shapes and PLKA allocation",
      "exact_schema_or_bound": "schemas; semantic-validator codes",
      "source_rationale": "plans delegate shapes/code range",
      "alternatives": [
        "event union",
        "shared core codes"
      ],
      "compatibility_consequence": "unknown fields/codes invalid",
      "falsifier_validation": "schema/vector/collision",
      "recommendation": "accept strict versioned contract and publish code registry"
    },
    {
      "id": "P03",
      "class": "irreducible_product_policy",
      "classification": "provisional",
      "value": "separate constructor-injected fault test-support artifact",
