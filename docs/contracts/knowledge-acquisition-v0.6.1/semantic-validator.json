  "calendar_algorithm": [
    "match UTC-Z lexical schema",
    "parse proleptic Gregorian year/month/day without locale",
    "require month 1..12",
    "days=31/30 or February 28 plus leap day iff year divisible by 4 and not 100 unless divisible by 400",
    "reject leap second 60",
    "parse fractional seconds as decimal digits without floating point",
    "round-trip to identical lexical components; no normalization"
  ],
  "graph_algorithm": [
    "index every object by content ID; duplicate ID with unequal bytes PLKA2002",
    "build directed edges owner->referenced ID with edge labels sorted UTF-8",
    "missing target PLKA2001",
    "Tarjan SCC traversal starting IDs UTF-8 sorted and neighbors (label,target) sorted; SCC size>1 or self-loop PLKA2002 unless transition chain schema explicitly permits predecessor edge",
    "topological Kahn order using UTF-8 ID min-heap",
    "validate provenance reachability, generation/root membership, transition causality and exactly one outstanding packet",
    "diagnostics sort by code,path UTF-8,object ID; emit one per violation key"
  ],
  "cross_field_rules": [
    "accept/reject forbid revision fields; revise requires note and exact released IDs",
    "create/replace/delete/retain digest nullability/equality conditions",
    "receipt preview digest and operation equal applied journal",
    "canonical before=after for repair/compact/remove/quarantine and every non-accept operation",
    "empty MCP page still has state provenance",
    "prompt/transcript fields never enter observed digest or persistence",
    "repair applicable=true requires exactly one selected verified root, one atomic replace action and no conflicts; false requires selected_root null, zero entries and at least one conflict",
    "lifecycle repair/remove receipt requires canonical_before=canonical_after and exact ordered three-query suite equality"
  ],
